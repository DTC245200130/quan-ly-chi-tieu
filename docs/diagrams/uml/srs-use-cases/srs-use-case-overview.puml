@startuml
title USE CASE TỔNG QUAN — HỆ THỐNG SỔ CHI TIÊU
scale 0.6

top to bottom direction
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam dpi 300
skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #F4FBF8
  BorderColor #299D78
  ArrowColor #345B52
}

actor "Người sử dụng" as User <<primary>>
actor "Google Gemini" as Gemini <<external>>
actor "Resend" as Resend <<external>>

rectangle "HỆ THỐNG SỔ CHI TIÊU" {
  package "TÀI KHOẢN" {
    usecase "UC001\nĐăng ký tài khoản" as UC001
    usecase "UC002\nĐăng nhập" as UC002
    usecase "UC003\nĐăng xuất" as UC003
    usecase "UC004\nKhôi phục mật khẩu" as UC004
    usecase "UC005\nQuản lý hồ sơ" as UC005
    UC001 -[hidden]right- UC002
    UC002 -[hidden]right- UC003
    UC003 -[hidden]right- UC004
    UC004 -[hidden]right- UC005
  }

  package "QUẢN LÝ TÀI CHÍNH" {
    usecase "UC006\nQuản lý danh mục" as UC006
    usecase "UC007\nQuản lý giao dịch" as UC007
    usecase "UC008\nQuản lý ngân sách" as UC008
    usecase "UC009\nQuản lý mục tiêu tiết kiệm" as UC009
    UC006 -[hidden]right- UC007
    UC007 -[hidden]right- UC008
    UC008 -[hidden]right- UC009
  }

  package "PHÂN TÍCH VÀ HỖ TRỢ" {
    usecase "UC010\nXem Dashboard" as UC010
    usecase "UC011\nXem báo cáo so sánh" as UC011
    usecase "UC012\nTrợ lý AI" as UC012
    UC010 -[hidden]right- UC011
    UC011 -[hidden]right- UC012
  }

  UC002 -[hidden]down- UC007
  UC007 -[hidden]down- UC011
}

User -- UC001
User -- UC002
User -- UC003
User -- UC004
User -- UC005
User -- UC006
User -- UC007
User -- UC008
User -- UC009
User -- UC010
User -- UC011
User -- UC012

Gemini -- UC012 : sinh nội dung tư vấn
Resend -- UC004 : gửi email đặt lại mật khẩu

@enduml
