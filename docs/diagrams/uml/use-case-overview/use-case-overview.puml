@startuml
title HỆ THỐNG QUẢN LÝ CHI TIÊU CÁ NHÂN CÓ TÍCH HỢP AI\nUse Case tổng quan — baseline RQ-009

left to right direction
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam dpi 300
skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #F7FAFC
  BorderColor #46627F
  ArrowColor #334155
}

actor "Người sử dụng" as User <<primary>>
actor "Google Gemini" as Gemini <<external>>
actor "Resend" as Resend <<external>>

rectangle "Sổ Chi Tiêu" {
  package "Tài khoản" {
    usecase "Đăng ký tài khoản" as UC_Register
    usecase "Đăng nhập" as UC_Login
    usecase "Khôi phục mật khẩu" as UC_Reset
    usecase "Quản lý hồ sơ" as UC_Profile
    usecase "Đăng xuất" as UC_Logout
  }

  package "Tài chính cá nhân" {
    usecase "Quản lý danh mục" as UC_Category
    usecase "Quản lý giao dịch" as UC_Transaction
    usecase "Quản lý ngân sách" as UC_Budget
    usecase "Quản lý mục tiêu\ntiết kiệm" as UC_Goal
    usecase "Xem Dashboard" as UC_Dashboard
    usecase "Xem báo cáo so sánh" as UC_Report
  }

  package "Trợ lý AI" {
    usecase "Trợ lý AI" as UC_Assistant
  }
}

UC_Register -[hidden]right-> UC_Category
UC_Category -[hidden]right-> UC_Assistant

User -- UC_Register
User -- UC_Login
User -- UC_Reset
User -- UC_Profile
User -- UC_Logout
User -- UC_Category
User -- UC_Transaction
User -- UC_Budget
User -- UC_Goal
User -- UC_Dashboard
User -- UC_Report
User -- UC_Assistant
Gemini -- UC_Assistant : tạo nội dung tư vấn
Resend -- UC_Reset : gửi email đặt lại mật khẩu

UC_Assistant -[hidden]right- Gemini
UC_Reset -[hidden]right- Resend

@enduml
