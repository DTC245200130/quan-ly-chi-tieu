@startuml
title BIỂU ĐỒ TUẦN TỰ — delete_category
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 24
skinparam dpi 300
skinparam shadowing false
skinparam sequence {
  ArrowColor #345B52
  LifeLineBorderColor #299D78
  ParticipantBorderColor #299D78
  ParticipantBackgroundColor #F4FBF8
}
actor "Người sử dụng" as User
boundary "Màn hình Danh mục" as UI
control "Backend\n(Router + Core)" as Backend
database "CSDL" as DB
User -> UI: Chọn delete_category
UI -> Backend: Gửi yêu cầu delete_category
activate Backend
Backend -> DB: Tìm Category theo quyền sở\nhữu
DB --> Backend: Kết quả
Backend -> Backend: Kiểm tra Transaction tham\nchiếu
Backend -> DB: Nếu không có, xóa và commit
DB --> Backend: Kết quả
Backend -> Backend: nếu có, trả lỗi
alt Xử lý thành công
  Backend --> UI: Thành công - Category bị\nxóa. Thất bại - dữ liệu giữ\nnguyên.
  UI --> User: Hiển thị kết quả
else Dữ liệu không hợp lệ hoặc lỗi xử lý
  Backend --> UI: Mã lỗi và thông báo phù hợp
  UI --> User: Hiển thị lỗi, giữ dữ liệu cần thiết
end
deactivate Backend
@enduml
