@startuml
title BIỂU ĐỒ TUẦN TỰ — deposit
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 24
skinparam dpi 300
skinparam shadowing false
skinparam sequence {
  ArrowColor #345B52
  LifeLineBorderColor #299D78
  ParticipantBorderColor #299D78
  ParticipantBackgroundColor #F4FBF8
}
actor "Người sử dụng" as User
boundary "Màn hình Mục tiêu tiết kiệm" as UI
control "Backend\n(Router + Core)" as Backend
database "CSDL" as DB
User -> UI: Chọn deposit
UI -> Backend: Gửi yêu cầu deposit
activate Backend
Backend -> Backend: Kiểm tra goal active
Backend -> Backend: Tính available_balance
Backend -> Backend: Chặn nếu amount vượt số dư
Backend -> DB: Tạo deposit và commit
DB --> Backend: Kết quả
alt Xử lý thành công
  Backend --> UI: Deposit được ghi;\ncurrent_amount tăng đúng\namount; lỗi thì không ghi.
  UI --> User: Hiển thị kết quả
else Dữ liệu không hợp lệ hoặc lỗi xử lý
  Backend --> UI: Mã lỗi và thông báo phù hợp
  UI --> User: Hiển thị lỗi, giữ dữ liệu cần thiết
end
deactivate Backend
@enduml
