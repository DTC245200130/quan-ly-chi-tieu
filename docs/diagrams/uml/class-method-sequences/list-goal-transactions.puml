@startuml
title BIỂU ĐỒ TUẦN TỰ — list_goal_transactions
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 24
skinparam dpi 300
skinparam shadowing false
skinparam sequence {
  ArrowColor #345B52
  LifeLineBorderColor #299D78
  ParticipantBorderColor #299D78
  ParticipantBackgroundColor #F4FBF8
}
actor "Người sử dụng" as User
boundary "Màn hình Mục tiêu tiết kiệm" as UI
control "Backend\n(Router + Core)" as Backend
database "CSDL" as DB
User -> UI: Chọn list_goal_transactions
UI -> Backend: Gửi yêu cầu list_goal_transactions
activate Backend
Backend -> Backend: Kiểm tra goal thuộc user
Backend -> DB: Lọc theo goal_id
DB --> Backend: Kết quả
Backend -> Backend: Sắp xếp mới nhất trước
Backend -> Backend: Trả danh sách
alt Xử lý thành công
  Backend --> UI: Chỉ lịch sử của goal đúng\nquyền được trả.
  UI --> User: Hiển thị kết quả
else Dữ liệu không hợp lệ hoặc lỗi xử lý
  Backend --> UI: Mã lỗi và thông báo phù hợp
  UI --> User: Hiển thị lỗi, giữ dữ liệu cần thiết
end
deactivate Backend
@enduml
