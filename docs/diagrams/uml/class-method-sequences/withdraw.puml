@startuml
title BIỂU ĐỒ TUẦN TỰ — withdraw
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 24
skinparam dpi 300
skinparam shadowing false
skinparam sequence {
  ArrowColor #345B52
  LifeLineBorderColor #299D78
  ParticipantBorderColor #299D78
  ParticipantBackgroundColor #F4FBF8
}
actor "Người sử dụng" as User
boundary "Màn hình Mục tiêu tiết kiệm" as UI
control "Backend\n(Router + Core)" as Backend
database "CSDL" as DB
User -> UI: Chọn withdraw
UI -> Backend: Gửi yêu cầu withdraw
activate Backend
Backend -> Backend: Kiểm tra goal active
Backend -> Backend: Tính current_amount
Backend -> Backend: Chặn nếu amount vượt current
Backend -> DB: Tạo withdraw và commit
DB --> Backend: Kết quả
alt Xử lý thành công
  Backend --> UI: Withdraw được ghi;\ncurrent_amount giảm; tiền\ntrở lại số dư khả dụng.
  UI --> User: Hiển thị kết quả
else Dữ liệu không hợp lệ hoặc lỗi xử lý
  Backend --> UI: Mã lỗi và thông báo phù hợp
  UI --> User: Hiển thị lỗi, giữ dữ liệu cần thiết
end
deactivate Backend
@enduml
