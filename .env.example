# Runtime mode
APP_ENV=development
AUTO_CREATE_SCHEMA=true
ENABLE_API_DOCS=true

# Local SQLite. Production should use postgresql+psycopg://...
DATABASE_URL=sqlite:///./expense.db
SECRET_KEY=replace-with-a-long-random-value

# Public URL used in password-reset emails
FRONTEND_URL=http://127.0.0.1:8000

# Allowed origins for the Windows desktop shell or a separately hosted frontend
CORS_ORIGINS=http://tauri.localhost,https://tauri.localhost
# Optional comma-separated host allowlist, for example app.example.com
TRUSTED_HOSTS=

# Optional integrations
AI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
RESEND_API_KEY=
RESEND_FROM_EMAIL=Expense Management AI <onboarding@resend.dev>

# Docker Compose
POSTGRES_PASSWORD=replace-with-a-strong-database-password
APP_PORT=8000
APP_BIND_ADDRESS=127.0.0.1
